/*
 * Treble (system-as-root / vendor-only) variant of tissot.
 * Includes the stock tissot board, then activates the vendor fstab entry
 * and activates the system entry too (system-as-root). fsmgr_flags
 * match A-only non-AB GSI-style ROMs; adjust to the target ROM's fstab
 * if needed.
 */
/dts-v1/;

#include "msm8953-qrd-sku3-tissot.dts"

&firmware {
	android {
		fstab {
			vendor {
				fsmgr_flags = "wait,avb";
				status = "ok";
			};
			system {
				fsmgr_flags = "wait,slotselect";
				status = "ok";
			};
		};
	};
};
